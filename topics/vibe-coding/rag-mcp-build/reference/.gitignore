# Operational ignores produced by the workshop run (kept as-is for reference).
docs/.tmp/
in-progress.md
.envrc.local
.template-local
.env
secrets/

# Python build artifacts — keep docs and source tracked; don't commit caches,
# venvs, or compiled output. Adding these here so the reference project is
# browsable without venv noise.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local data volumes / runtime artifacts
data/
*.log
